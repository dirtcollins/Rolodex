# Copy to app/.env.local and fill in. Never commit the filled-in file.

# Postgres (Supabase) connection string. Leave empty to use the local PGlite database in app/.data.
DATABASE_URL=
# Schema Rolodex uses inside that database.
RX_SCHEMA=rolodex
# Signs the sign-in cookie. At least 32 random characters; required when DATABASE_URL is set.
RX_AUTH_SECRET=
# First owner account, created on first start when there are no users.
RX_OWNER_NAME=
RX_OWNER_EMAIL=
RX_OWNER_PASSWORD=
# Resend API key for sending email. Leave empty (or set RX_EMAIL_TEST=1) to write emails to a test log instead.
RESEND_API_KEY=
RX_EMAIL_TEST=
# This Mac only: 1 opens the app without signing in, as the first owner (local database and localhost only).
RX_NO_LOGIN=
# Optional: folder for the local database. Defaults to app/.data.
RX_DATA=
